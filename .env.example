# POOLED connection — used by the application at runtime (and by Render).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# DIRECT (unpooled) connection — used by Prisma CLI for migrations / db push.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Simulation cadence for the local biometric engine, in milliseconds.
SIM_TICK_MS="4000"
